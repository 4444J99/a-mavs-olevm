      ],
      "interfaces": [
        "SceneManager"
      ]
    },
    {
      "id": "frequency-analyzer",
      "path": "js/3d/audio/AudioAnalyzer.js",
      "capability_ids": [
        "audio-feature-analysis"
      ],
      "interfaces": [
        "AudioAnalyzer"
      ]
    },
    {
      "id": "beat-detector",
      "path": "js/3d/audio/BeatDetector.js",
      "capability_ids": [
        "audio-feature-analysis"
      ],
      "interfaces": [
        "BeatDetector"
      ]
    },
    {
      "id": "spatial-stem-player",
      "path": "js/3d/ogod/OGODAudioEngine.js",
      "capability_ids": [
        "stem-playback"
      ],
      "interfaces": [
        "OGODAudioEngine (legacy global; artwork defaults remain)"
      ]
    },
    {
      "id": "image-grid-sequencer",
