  "software": {
    "id": "generative-multimedia-spatial-environment",
    "name": "Generative Multimedia Spatial Environment",
    "responsibility": "Compose browser scenes, analyze audio features, mix spatial stems and sequence image-grid frames within existing authored web environments."
  },
  "capabilities": [
    {
      "id": "spatial-scene-composition",
      "description": "Manage Three.js scene, camera, renderer, postprocessing and adaptive quality lifecycle."
    },
    {
      "id": "audio-feature-analysis",
      "description": "Analyze frequency bands and beat events for audiovisual reactivity."
    },
    {
      "id": "stem-playback",
      "description": "Play and spatially mix configured audio stems with existing legacy defaults and fallback paths."
    },
    {
      "id": "frame-sequencing",
      "description": "Advance image-grid frames using configured order and loop rules."
    }
  ],
  "modules": [
    {
      "id": "spatial-scene-compositor",
      "path": "js/3d/core/SceneManager.js",
      "capability_ids": [
